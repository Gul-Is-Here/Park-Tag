<!--
  Status-bar notification icon.

  Android renders this as a white-on-transparent silhouette: any colour or
  detail in it is discarded, so it is drawn as a flat filled shape. Without
  an explicit icon FCM falls back to the launcher icon, which the system
  then flattens into an unrecognisable white blob.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M20,2H4C2.9,2 2,2.9 2,4v18l4,-4h14c1.1,0 2,-0.9 2,-2V4C22,2.9 21.1,2 20,2z"/>
</vector>
